<Window
    x:Class="CDBurner10.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CDBurner10">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom Extended Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border
                    Width="22"
                    Height="22"
                    CornerRadius="6"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon
                        Glyph="&#xE958;"
                        FontSize="13"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    Text="CDBurner10"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleBarSubtitle"
                    Text="Optical Media Suite"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Main NavigationView Shell -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="230"
            SelectionChanged="NavView_SelectionChanged"
            ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Burn &amp; Create" />
                <NavigationViewItem Content="Data Disc" Tag="data">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Audio CD" Tag="audio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Video DVD" Tag="video">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Video Blu-ray" Tag="bluray">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Burn ISO Image" Tag="iso">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE958;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Copy Disc" Tag="copy">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Erase Disc" Tag="erase">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE75C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Tools" />
                <NavigationViewItem Content="Convert to ISO" Tag="convert">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="DVD to MP4" Tag="mp4">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Disc &amp; Drive Info" Tag="info">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Print Cover" Tag="cover">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE749;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="DropBoxNavItem"
                    Content="DropBox"
                    Tag="dropbox"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Bottom Optical Drive Status Bar -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE958;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <ComboBox
                        x:Name="DriveSelectorComboBox"
                        MinWidth="240"
                        PlaceholderText="No optical drive detected"
                        SelectionChanged="DriveSelectorComboBox_SelectionChanged" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="10,4"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="MediaStatusText"
                        Text="No optical drive detected"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        VerticalAlignment="Center" />
                </Border>

                <TextBlock
                    x:Name="EngineStatusText"
                    Grid.Column="2"
                    Text=""
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button
                        x:Name="EjectTrayButton"
                        Click="EjectTrayButton_Click"
                        ToolTipService.ToolTip="Eject tray"
                        Padding="8,4"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xF847;" FontSize="12" />
                            <TextBlock Text="Eject" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="LoadTrayButton"
                        Click="LoadTrayButton_Click"
                        ToolTipService.ToolTip="Close tray"
                        Padding="8,4"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                            <TextBlock Text="Load" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="RefreshDrivesButton"
                        Click="RefreshDrivesButton_Click"
                        ToolTipService.ToolTip="Refresh drives &amp; media"
                        Padding="8,4">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
