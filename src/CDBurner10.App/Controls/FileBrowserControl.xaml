<UserControl
    x:Class="CDBurner10.App.Controls.FileBrowserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CDBurner10.App.Controls">
    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Navigation & Filter Bar -->
            <Border
                Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Click="UpButton_Click"
                        ToolTipService.ToolTip="Up one level"
                        Padding="8,5">
                        <FontIcon Glyph="&#xE74A;" FontSize="13" />
                    </Button>

                    <Button
                        Grid.Column="1"
                        Click="RefreshButton_Click"
                        ToolTipService.ToolTip="Refresh folder"
                        Padding="8,5">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    </Button>

                    <TextBox
                        x:Name="PathTextBox"
                        Grid.Column="2"
                        PlaceholderText="Enter folder path..."
                        KeyDown="PathTextBox_KeyDown" />

                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="3"
                        PlaceholderText="Filter files..."
                        TextChanged="SearchTextBox_TextChanged" />

                    <Button
                        x:Name="AddSelectedButton"
                        Grid.Column="4"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="AddSelectedButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Add to Disc" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Split TreeView + File ListView -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="150" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Folder Tree -->
                <TreeView
                    x:Name="FolderTreeView"
                    Grid.Column="0"
                    SelectionMode="Single"
                    Expanding="FolderTreeView_Expanding"
                    ItemInvoked="FolderTreeView_ItemInvoked"
                    Padding="4">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="controls:FolderNodeItem">
                            <TreeViewItem
                                ItemsSource="{x:Bind Children}"
                                HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <Rectangle Grid.Column="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- File List -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Column Header -->
                    <Border
                        Grid.Row="0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,5">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="135" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Size" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Date Modified" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="FileListView"
                        Grid.Row="1"
                        SelectionMode="Extended"
                        CanDragItems="True"
                        DragItemsStarting="FileListView_DragItemsStarting"
                        SelectionChanged="FileListView_SelectionChanged"
                        DoubleTapped="FileListView_DoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="30" />
                                <Setter Property="Padding" Value="12,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="controls:FileSystemEntryItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="135" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ModifiedDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="EmptyFolderText"
                        Grid.Row="1"
                        Text="This folder is empty."
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
