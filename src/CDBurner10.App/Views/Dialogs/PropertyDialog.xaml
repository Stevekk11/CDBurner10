<ContentDialog
    x:Class="CDBurner10.App.Views.Dialogs.PropertyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Item Properties"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">
    <StackPanel Spacing="12" MinWidth="420">
        <TextBox x:Name="NameBox" Header="Name on Disc" />

        <Border
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="6"
            Padding="12,10">
            <Grid RowSpacing="6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="TypeText" Grid.Row="0" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Virtual Path:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="VirtualPathText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Source Path:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SourcePathText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Size:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SizeText" Grid.Row="3" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>
        </Border>

        <CheckBox x:Name="HiddenCheckBox" Content="Hidden attribute on disc" />

        <CalendarDatePicker
            x:Name="ModifiedDatePicker"
            Header="Modification Date"
            HorizontalAlignment="Stretch" />
    </StackPanel>
</ContentDialog>
