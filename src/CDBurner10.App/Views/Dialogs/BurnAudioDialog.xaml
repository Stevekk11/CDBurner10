<ContentDialog
    x:Class="CDBurner10.App.Views.Dialogs.BurnAudioDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Burn Audio CD"
    PrimaryButtonText="Burn Audio CD"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Closing="ContentDialog_Closing">
    <ScrollViewer MaxHeight="560" MinWidth="500">
        <StackPanel Spacing="14" Padding="0,4,12,4">
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="False" />

            <!-- Phase 1: Audio Burn Options -->
            <StackPanel x:Name="OptionsPanel" Spacing="12">
                <TextBlock
                    x:Name="SummaryText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="95" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="DriveComboBox"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Header="Target Drive"
                        PlaceholderText="No optical drive detected"
                        SelectionChanged="DriveComboBox_SelectionChanged" />
                    <ComboBox
                        x:Name="SpeedComboBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="Write Speed" />
                    <NumberBox
                        x:Name="CopiesBox"
                        Grid.Column="2"
                        Header="Copies"
                        Value="1"
                        Minimum="1"
                        Maximum="99"
                        SpinButtonPlacementMode="Compact" />
                </Grid>

                <!-- Gap Mode -->
                <RadioButtons x:Name="GapModeRadio" Header="Track Gap / Write Method" SelectedIndex="0" SelectionChanged="GapModeRadio_SelectionChanged">
                    <RadioButton Content="Pause between tracks (Track-at-Once / TAO)" />
                    <RadioButton Content="No pause — Gapless (Disc-at-Once / DAO-96)" />
                    <RadioButton Content="Use custom per-track pre- &amp; post-gaps (DAO-96)" />
                    <RadioButton Content="Crossfade consecutive tracks (DAO-96)" />
                </RadioButtons>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Name="PauseSecondsBox"
                        Grid.Column="0"
                        Header="TAO Pause Length (sec)"
                        Value="2"
                        Minimum="0"
                        Maximum="10"
                        SpinButtonPlacementMode="Compact" />
                    <NumberBox
                        x:Name="CrossfadeSecondsBox"
                        Grid.Column="1"
                        Header="Crossfade Duration (sec)"
                        Value="3"
                        Minimum="0.5"
                        Maximum="15"
                        SmallChange="0.5"
                        SpinButtonPlacementMode="Compact"
                        IsEnabled="False" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <CheckBox x:Name="CdTextCheckBox" Content="Write CD-Text (artist &amp; track titles)" IsChecked="True" />
                        <CheckBox x:Name="FinalizeCheckBox" Content="Finalize Audio CD" IsChecked="True" />
                        <CheckBox x:Name="SimulateCheckBox" Content="Simulate burning (test write)" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <CheckBox x:Name="EjectCheckBox" Content="Eject disc after burning" IsChecked="True" />
                        <CheckBox x:Name="ShutdownCheckBox" Content="Shut down PC after completion" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Phase 2: Progress & Log -->
            <StackPanel x:Name="ProgressPanel" Spacing="10" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="PhaseText" Text="Preparing tracks..." Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="TimeText"
                        HorizontalAlignment="Right"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ProgressBar x:Name="BurnProgressBar" Minimum="0" Maximum="100" Value="0" />
                <TextBlock x:Name="BufferText" Text="Device Buffer: 0%" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox
                    x:Name="EventLogBox"
                    Header="Event Log"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="150"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Button
                    x:Name="CancelBurnButton"
                    Content="Cancel Burn"
                    HorizontalAlignment="Right"
                    Click="CancelBurnButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
