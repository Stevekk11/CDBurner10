<ContentDialog
    x:Class="CDBurner10.App.Views.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About CDBurner10"
    CloseButtonText="Close"
    DefaultButton="Close">
    <StackPanel Spacing="14" MinWidth="420">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Border
                Width="52"
                Height="52"
                CornerRadius="12"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon
                    Glyph="&#xE958;"
                    FontSize="28"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="CDBurner10" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Version 10.0.0 • Modern Optical Media Suite" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Text="A modern .NET 10 + WinUI 3 (Windows App SDK) re-architecture of CDBurnerXP, delivering full CD, DVD, HD-DVD, and Blu-ray authoring with native Windows 11 Fluent Design."
            TextWrapping="Wrap" />

        <Border
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="6"
            Padding="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Technologies &amp; Credits" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="• Runtime: .NET 10 (win-x86) + WinUI 3 / Windows App SDK 1.7" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Optical Burning Engine: Rocket Division StarBurnX (Reg-Free COM)" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Audio Engine: NAudio (MIT) + TagLibSharp + FFmpeg + Win32 CD-DA" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Project Formats: Full CDBurnerXP .dxp / .axp &amp; CLI parity" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
