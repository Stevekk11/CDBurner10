<ContentDialog
    x:Class="CDBurner10.App.Views.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About CDBurner10"
    CloseButtonText="Close"
    DefaultButton="Close">
    <StackPanel Spacing="14" MinWidth="420">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Border
                Width="52"
                Height="52"
                CornerRadius="12"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon
                    Glyph="&#xE958;"
                    FontSize="28"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="CDBurner10" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Version 10.5.0 (64-bit) • Open-Source Optical Media Suite" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Text="An independent, 100% open-source .NET 10 + WinUI 3 (Windows App SDK) optical media suite for Windows, delivering full CD, DVD, HD-DVD, and Blu-ray authoring, audio ripping, and GPU-accelerated DVD to MP4 conversion with native Windows 11 Fluent Design."
            TextWrapping="Wrap" />

        <Border
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="6"
            Padding="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Technologies &amp; License" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="• License: GNU General Public License v3.0 (GPL-3.0-or-later)" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Runtime: .NET 10 (win-x64) + WinUI 3 / Windows App SDK 1.7" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Optical Burning Engine: Native Windows IMAPI2 + SPTI SCSI MMC" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• DVD &amp; Optical Libraries: libdvdnav, libdvdread, libdvdcss, libcdio (64-bit)" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Audio &amp; Video: NAudio + TagLibSharp + FFmpeg + Win32 CD-DA" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Project Formats: CDBurnerXP .dxp / .axp &amp; cdbxpcmd CLI parity" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
