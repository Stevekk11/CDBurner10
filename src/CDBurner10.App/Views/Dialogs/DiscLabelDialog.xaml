<ContentDialog
    x:Class="CDBurner10.App.Views.Dialogs.DiscLabelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Disc Labels &amp; Volume Metadata"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">
    <StackPanel Spacing="12" MinWidth="420">
        <TextBox
            x:Name="VolumeLabelBox"
            Header="Volume Label"
            PlaceholderText="Disc"
            TextChanged="VolumeLabelBox_TextChanged" />
        <TextBlock
            x:Name="LabelPreviewText"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <TextBox
            x:Name="PublisherBox"
            Header="Publisher"
            PlaceholderText="Optional publisher name" />

        <TextBox
            x:Name="ApplicationBox"
            Header="Application ID"
            PlaceholderText="CDBurner10" />
    </StackPanel>
</ContentDialog>
