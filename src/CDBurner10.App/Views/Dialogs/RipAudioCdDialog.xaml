<ContentDialog
    x:Class="CDBurner10.App.Views.Dialogs.RipAudioCdDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:CDBurner10.App.Views.Dialogs"
    Title="Rip Audio CD Tracks"
    PrimaryButtonText="Add to Compilation"
    SecondaryButtonText="Export Tracks to..."
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    Closing="ContentDialog_Closing">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>
    <StackPanel Spacing="12" MinWidth="640">
        <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="False" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="DriveComboBox"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Header="Audio CD Drive"
                PlaceholderText="No optical drive detected"
                SelectionChanged="DriveComboBox_SelectionChanged" />
            <ComboBox
                x:Name="ReadSpeedComboBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Header="Read Speed" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                Content="Refresh"
                VerticalAlignment="Bottom"
                Click="RefreshButton_Click" />
        </Grid>

        <ListView
            x:Name="AudioTracksListView"
            SelectionMode="Multiple"
            MaxHeight="220">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dialogs:AudioCdTrackRow">
                    <Grid Padding="4,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind TrackLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind SizeLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind DurationLabel}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <CheckBox
            x:Name="RecoverBadSectorsCheckBox"
            Content="Recover scratched sectors (retry &amp; pad unreadable frames)"
            IsChecked="True" />

        <ProgressBar x:Name="RipProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="RipStatusText"
                Grid.Column="0"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                x:Name="CancelRipButton"
                Grid.Column="1"
                Content="Cancel Rip"
                Visibility="Collapsed"
                Click="CancelRipButton_Click" />
        </Grid>
    </StackPanel>
</ContentDialog>
