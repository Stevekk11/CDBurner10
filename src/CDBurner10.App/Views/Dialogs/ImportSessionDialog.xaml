<ContentDialog
    x:Class="CDBurner10.App.Views.Dialogs.ImportSessionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:CDBurner10.App.Views.Dialogs"
    Title="Import Multi-Session Track"
    PrimaryButtonText="Import Selected"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <StackPanel Spacing="12" MinWidth="460">
        <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="False" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="DriveComboBox"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Header="Optical Drive"
                PlaceholderText="No optical drive detected"
                SelectionChanged="DriveComboBox_SelectionChanged" />
            <Button
                Grid.Column="1"
                Content="Refresh"
                VerticalAlignment="Bottom"
                Click="RefreshButton_Click" />
        </Grid>

        <TextBlock
            x:Name="MediaSummaryText"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Checking media..." />

        <ListView
            x:Name="TracksListView"
            SelectionMode="Single"
            MaxHeight="240"
            SelectionChanged="TracksListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dialogs:ImportTrackRow">
                    <Grid Padding="4,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind SessionLabel}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind TrackLabel}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind TypeLabel}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind SizeLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
