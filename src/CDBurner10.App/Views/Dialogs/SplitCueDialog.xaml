<ContentDialog
    x:Class="CDBurner10.App.Views.Dialogs.SplitCueDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:CDBurner10.App.Views.Dialogs"
    Title="Split Audio by CUE Sheet"
    PrimaryButtonText="Split Tracks"
    CloseButtonText="Close"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">
    <StackPanel Spacing="12" MinWidth="480">
        <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="False" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="CuePathBox"
                Grid.Column="0"
                Header="CUE Sheet File (.cue)"
                PlaceholderText="Select a .cue sheet file..."
                IsReadOnly="True" />
            <Button
                Grid.Column="1"
                Content="Browse..."
                VerticalAlignment="Bottom"
                Click="BrowseCueButton_Click" />
        </Grid>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="OutputFolderBox"
                Grid.Column="0"
                Header="Output Folder for Split WAV Tracks"
                PlaceholderText="Choose output directory..." />
            <Button
                Grid.Column="1"
                Content="Browse..."
                VerticalAlignment="Bottom"
                Click="BrowseOutputButton_Click" />
        </Grid>

        <TextBlock x:Name="TrackPreviewHeader" Text="Tracks Preview" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <ListView x:Name="CueTracksListView" SelectionMode="None" MaxHeight="200">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dialogs:CueTrackRow">
                    <Grid Padding="4,4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind NumberText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind StartTimeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressBar x:Name="SplitProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
