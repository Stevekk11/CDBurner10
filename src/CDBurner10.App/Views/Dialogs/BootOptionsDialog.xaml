<ContentDialog
    x:Class="CDBurner10.App.Views.Dialogs.BootOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bootable Disc Options"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">
    <ScrollViewer MaxHeight="520" MinWidth="460">
        <StackPanel Spacing="12" Padding="0,4,10,4">
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <ToggleSwitch
                x:Name="BootableToggle"
                Header="Make disc bootable (El Torito)"
                Toggled="BootableToggle_Toggled" />

            <StackPanel x:Name="BootSettingsPanel" Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="BootImagePathBox"
                        Grid.Column="0"
                        Header="Boot Image File (.ima, .img, .bin)"
                        PlaceholderText="Select boot sector image..." />
                    <Button
                        Grid.Column="1"
                        Content="Browse..."
                        VerticalAlignment="Bottom"
                        Click="BrowseBootImageButton_Click" />
                </Grid>

                <ComboBox x:Name="EmulationComboBox" Header="Emulation Type" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="No Emulation (Windows / Linux / WinPE)" Tag="CDROM" />
                    <ComboBoxItem Content="Floppy 1.44 MB" Tag="FLOPPY" />
                    <ComboBoxItem Content="Floppy 2.88 MB" Tag="FLOPPY288" />
                    <ComboBoxItem Content="Hard Disc Emulation" Tag="HDD" />
                </ComboBox>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PlatformComboBox" Grid.Column="0" Header="Platform" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="80x86 (PC)" Tag="0" />
                        <ComboBoxItem Content="PowerPC" Tag="1" />
                        <ComboBoxItem Content="Mac" Tag="2" />
                    </ComboBox>
                    <TextBox
                        x:Name="LoadSegmentBox"
                        Grid.Column="1"
                        Header="Load Segment (Hex)"
                        Text="7C0" />
                    <NumberBox
                        x:Name="SectorsBox"
                        Grid.Column="2"
                        Header="Sectors"
                        Value="1"
                        Minimum="1"
                        Maximum="255"
                        SpinButtonPlacementMode="Compact" />
                </Grid>

                <!-- Create Floppy Image Helper -->
                <Expander Header="Create Boot Image from Floppy / Removable Drive..." HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="FloppyDriveLetterBox"
                                Grid.Column="0"
                                Header="Drive Letter"
                                Text="A:"
                                PlaceholderText="A:" />
                            <Button
                                x:Name="CreateFloppyImageButton"
                                Grid.Column="1"
                                Content="Read &amp; Save Floppy Image..."
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Click="CreateFloppyImageButton_Click" />
                        </Grid>
                        <ProgressBar x:Name="FloppyProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
