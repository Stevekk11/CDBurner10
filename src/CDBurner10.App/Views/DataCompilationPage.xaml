<Page
    x:Class="CDBurner10.App.Views.DataCompilationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CDBurner10.App.Controls"
    xmlns:vm="using:CDBurner10.App.ViewModels">
    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & CommandBar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Data Compilation" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind ViewModel.CompilationSubtitle, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <CommandBar
                Grid.Column="1"
                DefaultLabelPosition="Right"
                Background="Transparent"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">
                <AppBarButton Label="Add Files" Click="AddFiles_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Add Folder" Click="AddFolder_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8F4;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="New Folder" Click="NewFolder_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Remove" Click="RemoveSelected_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Rename" Click="RenameSelected_Click" IsEnabled="{x:Bind ViewModel.HasSingleSelection, Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8AC;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Open .dxp" Click="OpenDxp_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Save .dxp" Click="SaveDxp_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                </AppBarButton>

                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Clear Compilation" Click="Clear_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE894;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Save as ISO..." Click="SaveIso_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE958;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Label="Import Session..." Click="ImportSession_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8B5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="File System (ISO / UDF)..." Click="FileSystem_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE9CE;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Boot Options..." Click="BootOptions_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE770;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Disc Label &amp; Metadata..." Click="DiscLabel_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8EC;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="File Filter..." Click="FileFilter_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE71C;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Disc Spanning..." Click="DiscSpanning_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE81E;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Item Properties..." Click="ItemProperties_Click" IsEnabled="{x:Bind ViewModel.HasSingleSelection, Mode=OneWay}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <Button
                Grid.Column="2"
                Style="{StaticResource AccentButtonStyle}"
                Click="BurnDisc_Click"
                VerticalAlignment="Center"
                Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE958;" FontSize="15" />
                    <TextBlock Text="Burn Disc" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Split Workspace: Top File Browser / Bottom Virtual Disc Layout -->
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="1.15*" MinHeight="200" />
            </Grid.RowDefinitions>

            <!-- Top: Integrated File Browser -->
            <controls:FileBrowserControl
                x:Name="FileBrowser"
                Grid.Row="0"
                ItemsAddRequested="FileBrowser_ItemsAddRequested" />

            <!-- Bottom: Virtual Disc Layout -->
            <Border
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                AllowDrop="True"
                DragOver="DiscLayout_DragOver"
                Drop="DiscLayout_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Disc Layout Header Bar -->
                    <Border
                        Grid.Row="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,6">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE958;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.DiscLabel, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.CurrentVirtualPath, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="8,2">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.FileSystemBadge, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                                <Border
                                    Visibility="{x:Bind ViewModel.IsBootableVisibility, Mode=OneWay}"
                                    Background="#330F766E"
                                    CornerRadius="4"
                                    Padding="8,2">
                                    <TextBlock
                                        Text="Bootable"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        FontWeight="SemiBold" />
                                </Border>
                                <TextBlock
                                    Text="{x:Bind ViewModel.ItemCountSummary, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Disc Folder Tree + Disc Items List -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="150" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Virtual Folder Tree -->
                        <TreeView
                            x:Name="DiscFolderTree"
                            Grid.Column="0"
                            ItemsSource="{x:Bind ViewModel.FolderTreeRoots}"
                            SelectionMode="Single"
                            ItemInvoked="DiscFolderTree_ItemInvoked"
                            Padding="4">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscFolderNode">
                                    <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="True">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </TreeViewItem>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <Rectangle Grid.Column="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Virtual Disc Items List -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Column Headers -->
                            <Border
                                Grid.Row="0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,5">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Size" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Modified" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Source Path" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <ListView
                                x:Name="DiscItemsListView"
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.CurrentFolderItems}"
                                SelectionMode="Extended"
                                SelectionChanged="DiscItemsListView_SelectionChanged"
                                DoubleTapped="DiscItemsListView_DoubleTapped">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="30" />
                                        <Setter Property="Padding" Value="12,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscListItem">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="125" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border
                                                    Visibility="{x:Bind HiddenBadgeVisibility}"
                                                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                    CornerRadius="3"
                                                    Padding="5,1"
                                                    VerticalAlignment="Center">
                                                    <TextBlock Text="Hidden" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind SizeDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind TypeDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind ModifiedDisplay}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind SourcePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel
                                Grid.Row="1"
                                Visibility="{x:Bind ViewModel.EmptyLayoutVisibility, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock
                                    Text="Drag &amp; drop files or folders here, or select items from the browser above."
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Disc Capacity Bar -->
        <controls:DiscCapacityBar
            x:Name="CapacityBar"
            Grid.Row="2"
            IsAudioMode="False" />
    </Grid>
</Page>
