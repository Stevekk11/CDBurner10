<Page
    x:Class="CDBurner10.App.Views.DvdToMp4Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">
    <ScrollViewer Padding="28,20">
        <StackPanel MaxWidth="900" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="DVD to MP4" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Convert the main movie directly from a DVD optical drive (single pass, no intermediate ISO needed), a DVD-Video ISO, or a VIDEO_TS folder into MP4. Menus, warnings and short advert titles are skipped automatically."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <!-- Source Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Source DVD" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <RadioButtons
                        x:Name="SourceModeRadio"
                        MaxColumns="2"
                        SelectedIndex="0"
                        SelectionChanged="SourceModeRadio_SelectionChanged">
                        <x:String>Optical Drive (Direct single-pass)</x:String>
                        <x:String>ISO File / VIDEO_TS Folder</x:String>
                    </RadioButtons>

                    <!-- Direct Optical Drive Panel -->
                    <StackPanel x:Name="OpticalSourcePanel" Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="SourceDriveComboBox"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Header="Optical Drive"
                                DisplayMemberPath="DisplayName"
                                SelectionChanged="SourceDriveComboBox_SelectionChanged" />
                            <ComboBox
                                x:Name="ReadSpeedComboBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="Read Speed" />
                            <Button
                                x:Name="RefreshDriveButton"
                                Grid.Column="2"
                                Content="Refresh"
                                VerticalAlignment="Bottom"
                                Click="RefreshDriveButton_Click" />
                        </Grid>
                        <TextBlock
                            x:Name="DriveStatusText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="Checking optical drive..." />
                    </StackPanel>

                    <!-- File / Folder Panel -->
                    <Grid x:Name="FileSourcePanel" ColumnSpacing="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SourcePathBox"
                            Grid.Column="0"
                            Header="DVD-Video ISO or VIDEO_TS folder"
                            PlaceholderText="Select or drop a .iso file or VIDEO_TS folder..."
                            TextChanged="SourcePathBox_TextChanged" />
                        <Button
                            x:Name="BrowseIsoButton"
                            Grid.Column="1"
                            Content="ISO..."
                            VerticalAlignment="Bottom"
                            Click="BrowseIsoButton_Click" />
                        <Button
                            x:Name="BrowseFolderButton"
                            Grid.Column="2"
                            Content="Folder..."
                            VerticalAlignment="Bottom"
                            Click="BrowseFolderButton_Click" />
                    </Grid>

                    <TextBlock
                        x:Name="DvdInfoText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Insert a DVD-Video disc or choose an ISO / VIDEO_TS folder to detect movie length and tracks." />
                </StackPanel>
            </Border>

            <!-- Output Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Output &amp; Encoding" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="DestinationPathBox"
                            Grid.Column="0"
                            Header="Destination MP4 file"
                            PlaceholderText="Output .mp4 file path..." />
                        <Button
                            x:Name="BrowseDestButton"
                            Grid.Column="1"
                            Content="Browse..."
                            VerticalAlignment="Bottom"
                            Click="BrowseDestButton_Click" />
                    </Grid>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="AudioComboBox"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Header="Audio track"
                            PlaceholderText="Detecting..."
                            DisplayMemberPath="DisplayName" />
                        <ComboBox
                            x:Name="SubtitleComboBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Header="Subtitles"
                            DisplayMemberPath="DisplayName" />
                        <ComboBox
                            x:Name="QualityComboBox"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Header="Quality"
                            SelectedIndex="1">
                            <ComboBoxItem Content="High quality (CRF 18)" Tag="18;slow" />
                            <ComboBoxItem Content="Balanced (CRF 21)" Tag="21;medium" />
                            <ComboBoxItem Content="Smaller file (CRF 24)" Tag="24;fast" />
                        </ComboBox>
                        <ComboBox
                            x:Name="EncoderComboBox"
                            Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            Header="Encoder"
                            SelectedIndex="0">
                            <ComboBoxItem Content="Auto (GPU if available)" Tag="auto" />
                            <ComboBoxItem Content="CPU (libx264)" Tag="sw" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            x:Name="StereoDownmixCheckBox"
                            Grid.Column="0"
                            Content="Stereo downmix"
                            VerticalAlignment="Bottom"
                            IsChecked="True" />
                        <CheckBox
                            x:Name="DeinterlaceCheckBox"
                            Grid.Column="1"
                            Content="Deinterlace interlaced video"
                            VerticalAlignment="Bottom"
                            IsChecked="True" />
                        <NumberBox
                            x:Name="TitleNumberBox"
                            Grid.Column="2"
                            Header="Title (0 = auto)"
                            Value="0"
                            Minimum="0"
                            Maximum="99"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="TitleNumberBox_ValueChanged" />
                        <TextBlock
                            x:Name="FfmpegStatusText"
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,6"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Checking ffmpeg..." />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="ConvertButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ConvertButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8AB;" FontSize="15" />
                        <TextBlock Text="Convert Movie to MP4" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    IsEnabled="False"
                    Click="CancelButton_Click" />
                <Button
                    x:Name="OpenMp4Button"
                    Content="Open MP4"
                    Visibility="Collapsed"
                    Click="OpenMp4Button_Click" />
                <Button
                    x:Name="ShowInFolderButton"
                    Content="Show in Folder"
                    Visibility="Collapsed"
                    Click="ShowInFolderButton_Click" />
            </StackPanel>

            <!-- Progress Card -->
            <Border
                x:Name="ProgressCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock x:Name="ProgressStatusText" Text="Converting..." Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="ProgressPercentText"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ProgressBar x:Name="ConvertProgressBar" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock
                        x:Name="ProgressDetailText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox
                        x:Name="EventLogBox"
                        Header="Event Log"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="130"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
