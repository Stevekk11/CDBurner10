<Page
    x:Class="CDBurner10.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CDBurner10.App.ViewModels">
    <ScrollViewer Padding="32,24">
        <StackPanel MaxWidth="1040" Spacing="24">
            <!-- Hero Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock
                        Text="Welcome to CDBurner10"
                        Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock
                        Text="Choose a burning or disc utility task to get started."
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Click="OpenCompilationButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Open Compilation (.dxp / .axp)" />
                        </StackPanel>
                    </Button>
                    <ToggleSwitch
                        x:Name="RememberLastProjectToggle"
                        OnContent="Remember last project"
                        OffContent="Remember last project"
                        Toggled="RememberLastProjectToggle_Toggled" />
                </StackPanel>
            </Grid>

            <!-- Live Optical Drive Summary Banner -->
            <InfoBar
                x:Name="DriveSummaryBanner"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Optical Drive Status"
                Message="{x:Bind ViewModel.DriveSummaryMessage, Mode=OneWay}" />

            <!-- 6 Interactive Task Cards (3x2 responsive grid) -->
            <GridView
                x:Name="TaskCardsGrid"
                ItemsSource="{x:Bind ViewModel.TaskCards}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="TaskCardsGrid_ItemClick">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,16,16" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HomeTaskCard">
                        <Border
                            Width="316"
                            Height="142"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        CornerRadius="8"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <FontIcon
                                            Glyph="{x:Bind IconGlyph}"
                                            FontSize="20"
                                            Foreground="White"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind Badge}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Text="{x:Bind Subtitle}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Quick Utilities Row -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Quick Utilities" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="Convert BIN/NRG/B5I images, inspect drive &amp; disc capabilities, or print covers."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Convert to ISO" Tag="convert" Click="QuickUtilityButton_Click" />
                        <Button Content="Disc &amp; Drive Info" Tag="info" Click="QuickUtilityButton_Click" />
                        <Button Content="Print Cover" Tag="cover" Click="QuickUtilityButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
