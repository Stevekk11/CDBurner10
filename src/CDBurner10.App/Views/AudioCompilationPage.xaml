<Page
    x:Class="CDBurner10.App.Views.AudioCompilationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CDBurner10.App.Controls"
    xmlns:vm="using:CDBurner10.App.ViewModels">
    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & CommandBar -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Audio CD Compilation" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind ViewModel.CompilationSubtitle, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <CommandBar
                Grid.Column="1"
                DefaultLabelPosition="Right"
                Background="Transparent"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">
                <AppBarButton Label="Add Audio" Click="AddAudioFiles_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Add Folder" Click="AddFolder_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8F4;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Playlist/CUE" Click="ImportPlaylist_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8FD;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Up" Click="MoveUp_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Down" Click="MoveDown_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Remove" Click="RemoveSelected_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>

                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Split CUE Sheet..." Click="SplitCue_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8C6;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Rip Audio CD..." Click="RipCd_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE958;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Randomize Track Order" Click="Randomize_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8B1;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Clear All Tracks" Click="Clear_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE894;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Label="Track CD-Text &amp; Gaps..." Click="TrackProperties_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8EC;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Label="Open .axp..." Click="OpenAxp_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Save .axp..." Click="SaveAxp_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Export CUE / M3U..." Click="ExportPlaylist_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Export Tracks to..." Click="ExportTracks_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <ComboBox
                x:Name="ReplayGainComboBox"
                Grid.Column="2"
                VerticalAlignment="Center"
                MinWidth="140"
                ToolTipService.ToolTip="ReplayGain normalization mode"
                SelectionChanged="ReplayGainComboBox_SelectionChanged">
                <ComboBoxItem Content="ReplayGain: Off" Tag="0" IsSelected="True" />
                <ComboBoxItem Content="ReplayGain: Track" Tag="1" />
                <ComboBoxItem Content="ReplayGain: Album" Tag="2" />
            </ComboBox>

            <Button
                Grid.Column="3"
                Style="{StaticResource AccentButtonStyle}"
                Click="BurnAudioCd_Click"
                VerticalAlignment="Center"
                Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8D6;" FontSize="15" />
                    <TextBlock Text="Burn Audio CD" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Split Workspace: Top Audio File Browser / Bottom Track List -->
        <Grid Grid.Row="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.9*" MinHeight="160" />
                <RowDefinition Height="1.1*" MinHeight="180" />
            </Grid.RowDefinitions>

            <!-- Audio File Browser (filtered to supported audio & playlist extensions) -->
            <controls:FileBrowserControl
                x:Name="FileBrowser"
                Grid.Row="0"
                FilterPattern="*.mp3;*.flac;*.wav;*.ogg;*.wma;*.opus;*.m4a;*.ape;*.wv;*.mpc;*.aif;*.aiff;*.m3u;*.m3u8;*.wpl;*.nra;*.cue"
                ItemsAddRequested="FileBrowser_ItemsAddRequested" />

            <!-- Audio Track List -->
            <Border
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                AllowDrop="True"
                DragOver="TrackList_DragOver"
                Drop="TrackList_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Column Header -->
                    <Border
                        Grid.Row="0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Artist" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Album" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Length" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="Bitrate" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="Format" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="7" Text="Pre/Post" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="8" Text="Path" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="TracksListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Tracks}"
                        SelectionMode="Extended"
                        CanReorderItems="True"
                        AllowDrop="True"
                        SelectionChanged="TracksListView_SelectionChanged"
                        DoubleTapped="TracksListView_DoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Padding" Value="12,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AudioTrackItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind TrackNumber}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Artist}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Album}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind DurationDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind BitrateDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Format}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind GapsDisplay}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="8" Text="{x:Bind FilePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        Grid.Row="1"
                        Visibility="{x:Bind ViewModel.EmptyTracksVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="Drag &amp; drop audio files or playlists here, or add tracks from the browser above."
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Integrated Modern Audio Player Bar -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button
                        x:Name="PlayPauseButton"
                        Click="PlayPause_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="10,6"
                        ToolTipService.ToolTip="Play / Pause">
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="14" />
                    </Button>
                    <Button
                        x:Name="StopButton"
                        Click="Stop_Click"
                        Padding="10,6"
                        ToolTipService.ToolTip="Stop">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        Text="{x:Bind ViewModel.NowPlayingTitle, Mode=OneWay}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NowPlayingArtist, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind ViewModel.ElapsedDisplay, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center"
                    MinWidth="44"
                    TextAlignment="Right" />

                <Slider
                    x:Name="SeekSlider"
                    Grid.Column="3"
                    Minimum="0"
                    Maximum="{x:Bind ViewModel.PlayerDurationSeconds, Mode=OneWay}"
                    Value="{x:Bind ViewModel.PlayerPositionSeconds, Mode=OneWay}"
                    VerticalAlignment="Center"
                    PointerCaptureLost="SeekSlider_PointerCaptureLost" />

                <TextBlock
                    Grid.Column="4"
                    Text="{x:Bind ViewModel.RemainingDisplay, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    MinWidth="48" />
            </Grid>
        </Border>

        <!-- Audio Disc Capacity Bar (74 / 80 / 90 / 99 min) -->
        <controls:DiscCapacityBar
            x:Name="CapacityBar"
            Grid.Row="3"
            IsAudioMode="True" />
    </Grid>
</Page>
