<UserControl
    x:Class="CDBurner10.App.Views.VideoFromFilePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CDBurner10.App.Views"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Pinned Header with Back Button -->
        <Grid
            Grid.Row="0"
            Padding="28,16,28,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel MaxWidth="980" HorizontalAlignment="Stretch" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Click="Back_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock x:Name="BackButtonText" Text="Back" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    x:Name="SubtitleText"
                    TextWrapping="Wrap"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Scrollable Body -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="28,16,28,20">
                <StackPanel MaxWidth="980" HorizontalAlignment="Stretch" Spacing="16">
                    <InfoBar
                        x:Name="StatusInfoBar"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="Preview"
                        Message="This feature is a UI placeholder. Encoding and burning are not implemented yet." />

                    <!-- Source Videos Card -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="Source Videos" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button x:Name="AddVideoButton" Click="AddVideo_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                                            <TextBlock Text="Add Video..." />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="MoveUpButton" Content="Move Up" IsEnabled="False" Click="MoveUp_Click" />
                                    <Button x:Name="MoveDownButton" Content="Move Down" IsEnabled="False" Click="MoveDown_Click" />
                                    <Button x:Name="RemoveVideoButton" Content="Remove" IsEnabled="False" Click="RemoveVideo_Click" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                x:Name="EmptySourceHintText"
                                Text="No videos added yet. Click 'Add Video...' to select one or more .mp4 or .mkv files."
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />

                            <ListView
                                x:Name="SourceListView"
                                SelectionMode="Single"
                                MaxHeight="220"
                                Visibility="Collapsed"
                                SelectionChanged="SourceListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="views:SourceVideoItem">
                                        <Grid Padding="4,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE714;" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock
                                                    Text="{x:Bind FileName}"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind DetailsText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Grid x:Name="DiscUsageRow" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="DiscUsageText"
                                    Text="Estimated Disc Usage: Add a video to calculate disc usage."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Options Card -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Options" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid ColumnSpacing="14" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox
                                    x:Name="DiscTypeCombo"
                                    Header="Target disc"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OptionCombo_SelectionChanged" />
                                <ComboBox
                                    x:Name="StandardCombo"
                                    Grid.Column="1"
                                    Header="Video standard"
                                    HorizontalAlignment="Stretch" />
                                <ComboBox
                                    x:Name="AspectCombo"
                                    Grid.Row="1"
                                    Header="Aspect ratio"
                                    HorizontalAlignment="Stretch" />
                                <ComboBox
                                    x:Name="QualityCombo"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Header="Quality"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OptionCombo_SelectionChanged" />
                                <ComboBox
                                    x:Name="AudioTrackCombo"
                                    Grid.Row="2"
                                    Header="Audio track"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OptionCombo_SelectionChanged" />
                                <ComboBox
                                    x:Name="SubtitleCombo"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Header="Subtitles"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="SubtitleCombo_SelectionChanged" />
                            </Grid>

                            <Grid x:Name="ExternalSrtRow" ColumnSpacing="10" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="ExternalSrtPathBox"
                                    Grid.Column="0"
                                    Header="External subtitle file (.srt)"
                                    PlaceholderText="Select an .srt subtitle file..." />
                                <Button
                                    x:Name="BrowseSrtButton"
                                    Grid.Column="1"
                                    Content="Browse..."
                                    VerticalAlignment="Bottom"
                                    Click="BrowseSrt_Click" />
                            </Grid>

                            <TextBox x:Name="DiscLabelBox" Header="Disc label" MaxLength="32" Text="MY_VIDEO" />
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch x:Name="MenuToggle" Grid.Column="0" Header="Create disc menu" IsOn="True" />
                                <ToggleSwitch x:Name="VerifyToggle" Grid.Column="1" Header="Verify after burning" IsOn="True" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Target Optical Drive & Write Speed Card (Video DVD mode) -->
                    <Border
                        x:Name="DriveCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Visibility="Collapsed">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Target Optical Drive &amp; Write Speed" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="DriveComboBox"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Header="Target Optical Drive"
                                    PlaceholderText="No optical drive detected"
                                    SelectionChanged="DriveComboBox_SelectionChanged" />
                                <ComboBox
                                    x:Name="SpeedComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Header="Write Speed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="BurnButton" Style="{StaticResource AccentButtonStyle}" Click="Burn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE714;" FontSize="15" />
                                <TextBlock x:Name="BurnButtonText" Text="Burn Video DVD" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveIsoButton" Click="SaveIso_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="15" />
                                <TextBlock Text="Save as ISO..." />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CancelButton"
                            Content="Cancel"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Click="CancelButton_Click" />
                    </StackPanel>

                    <!-- Live Progress & Log Card -->
                    <Border
                        x:Name="ProgressCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock x:Name="ProgressPhaseText" Text="Ready" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="ProgressTimeText"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" />
                            <TextBox
                                x:Name="EventLogBox"
                                Header="Event Log"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Height="130"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
