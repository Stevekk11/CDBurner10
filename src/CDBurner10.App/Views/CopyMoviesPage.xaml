<Page
    x:Class="CDBurner10.App.Views.CopyMoviesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CDBurner10.App.Views">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="32,24">
            <StackPanel MaxWidth="920" HorizontalAlignment="Stretch" Spacing="20">
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Copy Movies from Disc" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="Scan a data disc (including all subfolders) for movie files, review what was found, and copy them to your computer."
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Status InfoBar -->
                <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

                <!-- Source Drive Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="1. Source Data Disc" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="SourceDriveComboBox"
                                Grid.Column="0"
                                Header="Optical Drive"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="SourceDriveComboBox_SelectionChanged" />
                            <Button
                                x:Name="ScanButton"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="ScanButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                                    <TextBlock Text="Scan Disc" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock
                            x:Name="ScanStatusText"
                            Text="Select an optical drive with a data disc to scan for movies."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Found Movies Preview Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="2. Found Movies" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="SelectionSummaryText"
                                    Text="No movies found yet."
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="SelectAllButton" Content="Select All" Click="SelectAllButton_Click" IsEnabled="False" />
                                <Button x:Name="SelectNoneButton" Content="Select None" Click="SelectNoneButton_Click" IsEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <ListView
                            x:Name="MoviesListView"
                            MaxHeight="300"
                            SelectionMode="None"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            CornerRadius="6">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="views:MovieListRow">
                                    <Grid ColumnSpacing="12" Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Grid.Column="0"
                                            MinWidth="0"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                            Checked="MovieRowCheckBox_Changed"
                                            Unchecked="MovieRowCheckBox_Changed" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind FileName}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind LocationSummary}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind SizeText}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Destination & Options Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="3. Destination Folder &amp; Options" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="DestinationFolderBox"
                                Grid.Column="0"
                                Header="Save Movies To"
                                PlaceholderText="Choose destination folder..."
                                TextChanged="DestinationFolderBox_TextChanged" />
                            <Button
                                x:Name="BrowseFolderButton"
                                Grid.Column="1"
                                Content="Browse..."
                                VerticalAlignment="Bottom"
                                Click="BrowseFolderButton_Click" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <CheckBox x:Name="PreserveSubfoldersCheckBox" Content="Preserve subfolder structure" IsChecked="False" />
                            <CheckBox x:Name="IncludeSubtitlesCheckBox" Content="Copy matching subtitles (.srt, .sub, .ass)" IsChecked="True" />
                            <CheckBox x:Name="OverwriteExistingCheckBox" Content="Overwrite existing files" IsChecked="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Progress & Actions -->
                <StackPanel Spacing="10">
                    <ProgressBar x:Name="CopyProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ProgressText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="StartCopyButton"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="False"
                            Click="StartCopyButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="15" />
                                <TextBlock Text="Start Copy" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CancelCopyButton"
                            Content="Cancel"
                            IsEnabled="False"
                            Click="CancelCopyButton_Click" />
                        <Button
                            x:Name="OpenFolderButton"
                            Content="Open Destination Folder"
                            Visibility="Collapsed"
                            Click="OpenFolderButton_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
