<Page
    x:Class="CDBurner10.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,20">
            <StackPanel MaxWidth="920" HorizontalAlignment="Stretch" Spacing="14">
            <StackPanel Spacing="4" Margin="0,0,0,4">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="SettingsPathSubtitle"
                    Text="Configure CDBurner10 appearance, burning engine, data, and audio preferences."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <!-- Appearance -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                        <FontIcon Glyph="&#xE790;" FontSize="18" />
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Application theme and visual style" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="App Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Changes apply immediately to the application window." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeComboBox"
                            HorizontalAlignment="Right"
                            MinWidth="180"
                            SelectedIndex="0"
                            SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Use system setting" Tag="Default" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Notifications -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                        <FontIcon Glyph="&#xEA8F;" FontSize="18" />
                        <StackPanel>
                            <TextBlock Text="Notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Desktop notifications for operation start, progress milestones, completion, and errors" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="ShowNotificationsToggle" Header="Show notifications when operations start, complete, or fail" Toggled="SettingControl_Changed" />
                    <ToggleSwitch x:Name="ShowProgressNotificationsToggle" Header="Show progress notifications every 10% with time estimates" Toggled="SettingControl_Changed" />
                </StackPanel>
            </Expander>

            <!-- General -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                        <FontIcon Glyph="&#xE713;" FontSize="18" />
                        <StackPanel>
                            <TextBlock Text="General &amp; Burning Engine" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Startup behavior, temp folder, diagnostic logging, and legacy import" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Language" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Right" MinWidth="200" SelectionChanged="SettingControl_Changed">
                            <ComboBoxItem Content="System Default (English)" Tag="" />
                            <ComboBoxItem Content="English (en-US)" Tag="en-US" />
                            <ComboBoxItem Content="Deutsch (de-DE)" Tag="de-DE" />
                            <ComboBoxItem Content="Čeština (cs-CZ)" Tag="cs-CZ" />
                            <ComboBoxItem Content="Polski (pl-PL)" Tag="pl-PL" />
                            <ComboBoxItem Content="Slovenčina (sk-SK)" Tag="sk-SK" />
                            <ComboBoxItem Content="Español (es-ES)" Tag="es-ES" />
                        </ComboBox>
                    </Grid>

                    <ToggleSwitch x:Name="RememberLastProjectToggle" Header="Remember last used project type on startup" Toggled="SettingControl_Changed" />
                    <ToggleSwitch x:Name="AskHowToBurnDataToggle" Header="Ask how to burn data disc before starting" Toggled="SettingControl_Changed" />
                    <ToggleSwitch x:Name="ExitToTrayToggle" Header="Minimize / exit to notification tray" Toggled="SettingControl_Changed" />

                    <!-- Custom Temp Folder -->
                    <StackPanel Spacing="8">
                        <ToggleSwitch x:Name="UseCustomTempToggle" Header="Use custom temporary folder for image &amp; audio caching" Toggled="SettingControl_Changed" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="CustomTempFolderBox"
                                Grid.Column="0"
                                PlaceholderText="Select temporary folder..."
                                TextChanged="SettingText_Changed" />
                            <Button Grid.Column="1" Content="Browse..." Click="BrowseTempFolderButton_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- Diagnostic Logging -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="LoggingEnabledToggle" Grid.Column="0" Header="Enable diagnostic logging" Toggled="SettingControl_Changed" />
                        <ComboBox x:Name="LoggingLevelComboBox" Grid.Column="1" Header="Log Level" HorizontalAlignment="Stretch" SelectionChanged="SettingControl_Changed">
                            <ComboBoxItem Content="Low (0)" Tag="0" />
                            <ComboBoxItem Content="Medium (Default)" Tag="-1" />
                            <ComboBoxItem Content="High (2)" Tag="2" />
                        </ComboBox>
                        <Button
                            x:Name="OpenLogsFolderButton"
                            Grid.Column="2"
                            Content="Open Logs Folder"
                            VerticalAlignment="Bottom"
                            Click="OpenLogsFolderButton_Click" />
                    </Grid>

                    <!-- Import & Reset Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button Content="Import Legacy UserSettings.ini..." Click="ImportLegacyIniButton_Click" />
                        <Button Content="Reset All Settings to Defaults" Click="ResetDefaultsButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Data Burning Settings -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="18" />
                        <StackPanel>
                            <TextBlock Text="Data Compilation" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Default disc label, file caching, file system, and size units" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBox
                            x:Name="DefaultDiscLabelBox"
                            Header="Default Disc Label"
                            PlaceholderText="Disc"
                            TextChanged="DefaultDiscLabelBox_TextChanged" />
                        <TextBlock
                            x:Name="DiscLabelHintText"
                            Text="Variables: $date, $time, $year, $yr, $month, $day, $hour, $minute, $user"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ToggleSwitch x:Name="AutoCacheRemovableToggle" Header="Automatically cache files from removable media" Toggled="SettingControl_Changed" />
                    <ToggleSwitch x:Name="AutoCacheNetworkToggle" Header="Automatically cache files from network shares" Toggled="SettingControl_Changed" />
                    <ToggleSwitch x:Name="AutoUpdateCompilationsToggle" Header="Automatically update compilations when opened" Toggled="SettingControl_Changed" />
                    <ToggleSwitch x:Name="IgnoreFileRenameToggle" Header="Ignore file rename requirement prompts" Toggled="SettingControl_Changed" />
                    <ToggleSwitch x:Name="SingleSizeUnitToggle" Header="Use single size unit (MB) in capacity displays" Toggled="SettingControl_Changed" />

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DefaultFileSystemComboBox" Grid.Column="0" HorizontalAlignment="Stretch" Header="Default File System" SelectionChanged="SettingControl_Changed">
                            <ComboBoxItem Content="Automatic (ISO9660 / Joliet)" Tag="-1" />
                            <ComboBoxItem Content="ISO9660 / Joliet" Tag="0" />
                            <ComboBoxItem Content="UDF (Universal Disk Format)" Tag="1" />
                        </ComboBox>
                        <ComboBox x:Name="DefaultUdfVersionComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Header="Default UDF Version" SelectionChanged="SettingControl_Changed">
                            <ComboBoxItem Content="Default (UDF 1.02)" Tag="-1" />
                            <ComboBoxItem Content="UDF 1.02" Tag="0" />
                            <ComboBoxItem Content="UDF 1.50" Tag="1" />
                            <ComboBoxItem Content="UDF 2.00" Tag="2" />
                            <ComboBoxItem Content="UDF 2.01" Tag="3" />
                            <ComboBoxItem Content="UDF 2.50" Tag="4" />
                            <ComboBoxItem Content="UDF 2.60" Tag="5" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Audio Settings -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                        <FontIcon Glyph="&#xE8D6;" FontSize="18" />
                        <StackPanel>
                            <TextBlock Text="Audio Compilation" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="CD-Text metadata, ReplayGain normalization, pauses, crossfade, and player" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="AutoCdTextToggle" Header="Automatically populate CD-Text from audio file tags" Toggled="SettingControl_Changed" />
                    <ToggleSwitch x:Name="ShowAudioPlayerToggle" Header="Show embedded Audio Player in Audio Compilation" Toggled="SettingControl_Changed" />

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ReplayGainComboBox" Grid.Column="0" HorizontalAlignment="Stretch" Header="ReplayGain Normalization" SelectionChanged="SettingControl_Changed">
                            <ComboBoxItem Content="None (Disabled)" Tag="0" />
                            <ComboBoxItem Content="Track Gain" Tag="1" />
                            <ComboBoxItem Content="Album Gain" Tag="2" />
                        </ComboBox>
                        <NumberBox
                            x:Name="DefaultPauseBox"
                            Grid.Column="1"
                            Header="Default Pause (sec)"
                            Minimum="0"
                            Maximum="10"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="SettingNumber_Changed" />
                        <NumberBox
                            x:Name="CrossfadeDurationBox"
                            Grid.Column="2"
                            Header="Crossfade (sec)"
                            Minimum="0"
                            Maximum="15"
                            SmallChange="0.5"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="SettingNumber_Changed" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- About Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="About CDBurner10" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="CDBurner10 v10.5 (64-bit, GPLv3) • Built with .NET 10 + WinUI 3 • Powered by Windows IMAPI2, SPTI, NAudio, FFmpeg, and libdvdnav/libdvdcss."
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            ToolTipService.ToolTip="Open CDBurner10 on GitHub"
                            Click="GitHubButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="16" Height="16" Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                                <TextBlock Text="GitHub" />
                            </StackPanel>
                        </Button>
                        <Button
                            Content="About CDBurner10..."
                            Click="AboutButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
