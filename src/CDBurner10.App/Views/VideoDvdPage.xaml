<Page
    x:Class="CDBurner10.App.Views.VideoDvdPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,20">
        <StackPanel MaxWidth="980" Spacing="18">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Burn Video DVD" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Author and burn a DVD-Video compliant disc from a VIDEO_TS folder, or save it as an ISO image."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar
                x:Name="StatusInfoBar"
                IsOpen="False"
                IsClosable="True" />

            <!-- Source Folders Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Source Folders" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <!-- VIDEO_TS -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="VideoTsPathBox"
                            Grid.Column="0"
                            Header="VIDEO_TS Folder (required)"
                            PlaceholderText="Select folder containing .IFO, .BUP, and .VOB files..."
                            TextChanged="VideoTsPathBox_TextChanged" />
                        <Button
                            x:Name="BrowseVideoTsButton"
                            Grid.Column="1"
                            Content="Browse..."
                            VerticalAlignment="Bottom"
                            Click="BrowseVideoTsButton_Click" />
                    </Grid>

                    <InfoBar
                        x:Name="ValidationInfoBar"
                        IsOpen="False"
                        IsClosable="False" />

                    <!-- Optional AUDIO_TS & Extra Files -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="AudioTsPathBox"
                                Grid.Column="0"
                                Header="AUDIO_TS Folder (optional)"
                                PlaceholderText="Optional AUDIO_TS folder" />
                            <Button
                                Grid.Column="1"
                                Content="Browse"
                                VerticalAlignment="Bottom"
                                Click="BrowseAudioTsButton_Click" />
                        </Grid>

                        <Grid Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="ExtraFilesPathBox"
                                Grid.Column="0"
                                Header="Extra Files Folder (optional)"
                                PlaceholderText="Optional DVD-ROM extra files" />
                            <Button
                                Grid.Column="1"
                                Content="Browse"
                                VerticalAlignment="Bottom"
                                Click="BrowseExtraFilesButton_Click" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Drive & Burn Settings Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Target Drive &amp; Options" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="14" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ComboBox
                            x:Name="DriveComboBox"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Header="Target Optical Drive"
                            PlaceholderText="No optical drive detected"
                            SelectionChanged="DriveComboBox_SelectionChanged" />

                        <ComboBox
                            x:Name="SpeedComboBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Header="Write Speed" />

                        <NumberBox
                            x:Name="CopiesBox"
                            Grid.Row="0"
                            Grid.Column="2"
                            Header="Copies"
                            Value="1"
                            Minimum="1"
                            Maximum="99"
                            SpinButtonPlacementMode="Compact" />

                        <TextBox
                            x:Name="DiscNameBox"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Header="Disc Label (Volume Name)"
                            Text="DVD_VIDEO"
                            PlaceholderText="DVD_VIDEO" />
                    </Grid>

                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <CheckBox x:Name="DoubleLayerCheckBox" Content="Double-Layer compatible mode" IsChecked="True" />
                            <CheckBox x:Name="PadDvdCheckBox" Content="Pad DVD-Video size to at least 1 GB (high compatibility)" IsChecked="True" />
                            <CheckBox x:Name="PatchIfoBupCheckBox" Content="Patch IFO/BUP files automatically" IsChecked="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <CheckBox x:Name="VerifyCheckBox" Content="Verify data after burning" />
                            <CheckBox x:Name="EjectCheckBox" Content="Eject disc after burning" IsChecked="True" />
                            <CheckBox x:Name="ShutdownCheckBox" Content="Shut down computer after completion" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="BurnButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="BurnButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE714;" FontSize="15" />
                        <TextBlock Text="Burn Video DVD" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="SaveIsoButton"
                    Click="SaveIsoButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="15" />
                        <TextBlock Text="Save as ISO..." />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    IsEnabled="False"
                    Click="CancelButton_Click" />
            </StackPanel>

            <!-- Live Progress & Log Card -->
            <Border
                x:Name="ProgressCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock x:Name="ProgressPhaseText" Text="Ready" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="ProgressTimeText"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ProgressBar x:Name="BurnProgressBar" Minimum="0" Maximum="100" Value="0" />
                    <TextBox
                        x:Name="EventLogBox"
                        Header="Event Log"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="130"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
