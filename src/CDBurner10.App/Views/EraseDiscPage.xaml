<Page
    x:Class="CDBurner10.App.Views.EraseDiscPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,20">
            <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Text="Erase Disc" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Erase rewritable CD-RW, DVD±RW, DVD-RAM, or BD-RE discs quickly or securely."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <!-- Drive & Disc Status Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Drive &amp; Media Status" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="DriveComboBox"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Header="Optical Drive"
                            PlaceholderText="No optical drive detected"
                            SelectionChanged="DriveComboBox_SelectionChanged" />
                        <Button
                            Grid.Column="1"
                            Content="Refresh"
                            VerticalAlignment="Bottom"
                            Click="RefreshButton_Click" />
                        <Button
                            Grid.Column="2"
                            Content="Eject"
                            VerticalAlignment="Bottom"
                            Click="EjectButton_Click" />
                    </Grid>

                    <!-- Live Disc Status Badge -->
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="14,10">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Media Type" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MediaTypeText" Text="No Disc" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Disc Status" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="DiscStateText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="Erasable" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ErasableText" Text="No" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Erase Method Card -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Erase Method" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <RadioButtons x:Name="EraseMethodRadio" SelectedIndex="0">
                        <RadioButton Content="Fast Erase — Clears the Table of Contents (takes less than a minute)" />
                        <RadioButton Content="Secure / Full Erase — Overwrites the entire disc surface (slower, cannot be recovered)" />
                    </RadioButtons>

                    <CheckBox x:Name="EjectAfterEraseCheckBox" Content="Eject disc after erasing" IsChecked="True" />
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="EraseButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="EraseButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE75C;" FontSize="15" />
                        <TextBlock Text="Erase Disc" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    IsEnabled="False"
                    Click="CancelButton_Click" />
            </StackPanel>

            <!-- Progress Card -->
            <Border
                x:Name="ProgressCard"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock x:Name="ProgressStatusText" Text="Erasing..." Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="ProgressTimeText"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ProgressBar x:Name="EraseProgressBar" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
