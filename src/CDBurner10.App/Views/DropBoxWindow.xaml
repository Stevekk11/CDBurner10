<Window
    x:Class="CDBurner10.App.Views.DropBoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CDBurner10 DropBox">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="DropZone"
        AllowDrop="True"
        DragOver="DropZone_DragOver"
        DragLeave="DropZone_DragLeave"
        Drop="DropZone_Drop"
        Padding="14">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Paste Files" Click="PasteMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE77F;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Close DropBox" Click="CloseMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <Border
            x:Name="DropBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="10"
            Padding="14">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <FontIcon Glyph="&#xE896;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="TargetTitleText"
                    Text="Drop files for Data Disc"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="StatusText"
                    Text="Drag &amp; drop files or folders here"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
