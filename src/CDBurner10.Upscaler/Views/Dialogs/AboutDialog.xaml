<ContentDialog
    x:Class="CDBurner10.Upscaler.Views.Dialogs.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About CDBurner10 Upscaler"
    CloseButtonText="Close"
    DefaultButton="Close">
    <StackPanel Spacing="14" MinWidth="420">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Border
                Width="52"
                Height="52"
                CornerRadius="12"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon
                    Glyph="&#xE740;"
                    FontSize="28"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="CDBurner10 Upscaler" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Version 10.5.9 (64-bit) • Open-Source AI &amp; Shader Video Upscaler" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Text="A companion WinUI 3 video upscaling application for CDBurner10 powered by libmpv GPU GLSL shaders (Anime4K v4 &amp; ArtCNN C4F32/C4F16), ONNX Runtime DirectML (ArtCNN R16F96 &amp; R8F64), and FFmpeg hardware/software encoding."
            TextWrapping="Wrap" />

        <Border
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="6"
            Padding="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Technologies &amp; License" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="• License: GNU General Public License v3.0 (GPL-3.0-or-later)" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Runtime: .NET 10 (win-x64) + WinUI 3 / Windows App SDK 1.7" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Shader Engine: libmpv + OpenGL 4.3+ Offscreen Compute FBO" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Presets: Anime4K (A, B, C, A+, B+, C+) &amp; ArtCNN (R16F96, R8F64, C4F32, C4F16)" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="• Neural Inference: ONNX Runtime DirectML GPU + FFmpeg" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>

        <Button
            HorizontalAlignment="Left"
            ToolTipService.ToolTip="Open CDBurner10 on GitHub"
            Click="GitHubButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="16" Height="16" Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                <TextBlock Text="View on GitHub" />
            </StackPanel>
        </Button>
    </StackPanel>
</ContentDialog>
