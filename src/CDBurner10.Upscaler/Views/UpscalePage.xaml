<Page
    x:Class="CDBurner10.Upscaler.Views.UpscalePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,20">
            <StackPanel MaxWidth="920" HorizontalAlignment="Stretch" Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="Video Upscaler" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="Drag and drop or browse an .mp4 or .mkv video, select an Anime4K or ArtCNN preset, choose output format and folder, and click Upscale."
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

                <!-- Source Video Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Source Video" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <!-- Drop Zone -->
                        <Border
                            x:Name="DropZoneBorder"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,14">
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE898;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="Drag &amp; drop an .mp4 or .mkv file here, or select below"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="SourcePathBox"
                                Grid.Column="0"
                                Header="Video file (.mp4 / .mkv)"
                                PlaceholderText="Select or drop an .mp4 or .mkv file..."
                                TextChanged="SourcePathBox_TextChanged" />
                            <Button
                                x:Name="BrowseSourceButton"
                                Grid.Column="1"
                                Content="Browse..."
                                VerticalAlignment="Bottom"
                                Click="BrowseSourceButton_Click" />
                        </Grid>

                        <TextBlock
                            x:Name="SourceInfoText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="Select an .mp4 or .mkv video to inspect resolution, framerate, and audio streams." />
                    </StackPanel>
                </Border>

                <!-- Upscaler Preset Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Upscaler Preset" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="PresetComboBox"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Header="CNN / Shader Model"
                                DisplayMemberPath="DisplayName"
                                SelectionChanged="PresetComboBox_SelectionChanged" />
                            <ComboBox
                                x:Name="ScaleComboBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="Scale Factor"
                                SelectionChanged="ScaleComboBox_SelectionChanged">
                                <ComboBoxItem Content="2× (Native CNN / Shader)" Tag="2" />
                                <ComboBoxItem Content="4× (Double Scale)" Tag="4" />
                            </ComboBox>
                        </Grid>

                        <!-- Selected Model Specifications -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Padding="14,10">
                            <Grid RowSpacing="8" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Architecture" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SpecArchText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Blocks / Layers" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SpecLayersText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Filters" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SpecFiltersText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="3" Spacing="2">
                                    <TextBlock Text="Parameters" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SpecParamsText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="4" Spacing="2">
                                    <TextBlock Text="Est. / 10 min" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SpecEstRuntimeText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="5" Spacing="2">
                                    <TextBlock Text="Execution Backend" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SpecBackendText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="SpecUsageText"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Output Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Output" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="OutputFormatComboBox"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Header="Output Format"
                                SelectionChanged="OutputFormatComboBox_SelectionChanged">
                                <ComboBoxItem Content="MP4 (.mp4)" Tag="mp4" />
                                <ComboBoxItem Content="MKV (.mkv)" Tag="mkv" />
                            </ComboBox>
                            <TextBox
                                x:Name="OutputFolderBox"
                                Grid.Column="1"
                                Header="Output Folder"
                                PlaceholderText="Select destination folder..."
                                TextChanged="OutputFolderBox_TextChanged" />
                            <Button
                                x:Name="BrowseOutputFolderButton"
                                Grid.Column="2"
                                Content="Browse..."
                                VerticalAlignment="Bottom"
                                Click="BrowseOutputFolderButton_Click" />
                        </Grid>

                        <TextBlock
                            x:Name="OutputPreviewText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="Output filename: &lt;preset&gt;_&lt;video&gt;.mp4" />
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="UpscaleButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="UpscaleButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE740;" FontSize="15" />
                            <TextBlock Text="Upscale" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CancelButton"
                        Content="Cancel"
                        IsEnabled="False"
                        Click="CancelButton_Click" />
                    <Button
                        x:Name="OpenVideoButton"
                        Content="Open Video"
                        Visibility="Collapsed"
                        Click="OpenVideoButton_Click" />
                    <Button
                        x:Name="ShowInFolderButton"
                        Content="Show in Folder"
                        Visibility="Collapsed"
                        Click="ShowInFolderButton_Click" />
                </StackPanel>

                <!-- Progress Card -->
                <Border
                    x:Name="ProgressCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock x:Name="ProgressStatusText" Text="Upscaling..." Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="ProgressPercentText"
                                HorizontalAlignment="Right"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ProgressBar x:Name="UpscaleProgressBar" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock
                            x:Name="ProgressDetailText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox
                            x:Name="EventLogBox"
                            Header="Event Log"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Height="140"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
