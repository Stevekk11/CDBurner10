<Page
    x:Class="CDBurner10.Upscaler.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,20">
            <StackPanel MaxWidth="920" HorizontalAlignment="Stretch" Spacing="14">
                <StackPanel Spacing="4" Margin="0,0,0,4">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="SettingsPathSubtitle"
                        Text="Configure CDBurner10 Upscaler appearance, libmpv shaders, ONNX runtime, and encoding."
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

                <!-- Appearance -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                            <FontIcon Glyph="&#xE790;" FontSize="18" />
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Application theme and visual style" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="App Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Changes apply immediately to the application window." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemeComboBox"
                                HorizontalAlignment="Right"
                                MinWidth="180"
                                SelectedIndex="0"
                                SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Use system setting" Tag="Default" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Notifications & Tray -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                            <FontIcon Glyph="&#xEA8F;" FontSize="18" />
                            <StackPanel>
                                <TextBlock Text="Notifications &amp; Tray" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Desktop alerts for start, 10% milestones, completion, errors, and system tray behavior" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12">
                        <ToggleSwitch x:Name="ShowNotificationsToggle" Header="Show notifications when upscaling starts, completes, or fails" Toggled="SettingControl_Changed" />
                        <ToggleSwitch x:Name="ShowProgressNotificationsToggle" Header="Show progress notifications every 10% with time estimates" Toggled="SettingControl_Changed" />
                        <ToggleSwitch x:Name="ExitToTrayToggle" Header="Minimize / exit to notification tray" Toggled="SettingControl_Changed" />
                    </StackPanel>
                </Expander>

                <!-- libmpv, Shaders & ONNX Engine -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                            <FontIcon Glyph="&#xE7F4;" FontSize="18" />
                            <StackPanel>
                                <TextBlock Text="libmpv, Shaders &amp; ONNX Engine" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Configure libmpv-2.dll location, Anime4K shader tier, GLSL renderer, and ONNX DirectML execution" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="libmpv Runtime Status" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="LibMpvStatusText" Text="Checking libmpv-2.dll..." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Download libmpv..." Click="DownloadLibMpvButton_Click" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Recheck" Click="RefreshStatusButton_Click" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Custom libmpv-2.dll Path (Optional)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="CustomLibMpvPathBox"
                                    Grid.Column="0"
                                    PlaceholderText="Leave empty to auto-detect bundled or system libmpv-2.dll..."
                                    TextChanged="SettingText_Changed" />
                                <Button Grid.Column="1" Content="Browse..." Click="BrowseLibMpvButton_Click" />
                                <Button Grid.Column="2" Content="Clear" Click="ClearLibMpvButton_Click" />
                            </Grid>
                        </StackPanel>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="Anime4KTierComboBox" Grid.Column="0" HorizontalAlignment="Stretch" Header="Anime4K Shader Chain Tier" SelectionChanged="SettingControl_Changed">
                                <ComboBoxItem Content="HQ (Mode A / B / C / A+ / B+ / C+)" Tag="HQ" />
                                <ComboBoxItem Content="Fast (Lighter GLSL passes)" Tag="Fast" />
                            </ComboBox>
                            <ComboBox x:Name="MpvRendererComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Header="libmpv Video Output (vo=libmpv)" SelectionChanged="SettingControl_Changed">
                                <ComboBoxItem Content="gpu-next (libplacebo modern pipeline)" Tag="gpu-next" />
                                <ComboBoxItem Content="gpu (classic OpenGL pipeline)" Tag="gpu" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MpvHwdecComboBox" Grid.Column="0" HorizontalAlignment="Stretch" Header="libmpv Hardware Decoding" SelectionChanged="SettingControl_Changed">
                                <ComboBoxItem Content="Auto Copy-Back (Recommended)" Tag="auto-copy" />
                                <ComboBoxItem Content="Software CPU Decode (no)" Tag="no" />
                            </ComboBox>
                            <ComboBox x:Name="MpvScalerComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Header="Fallback / Chroma Kernel" SelectionChanged="SettingControl_Changed">
                                <ComboBoxItem Content="EWA Lanczos Sharp (ewa_lanczossharp)" Tag="ewa_lanczossharp" />
                                <ComboBoxItem Content="Spline36 (spline36)" Tag="spline36" />
                                <ComboBoxItem Content="Lanczos (lanczos)" Tag="lanczos" />
                                <ComboBoxItem Content="Bilinear (bilinear)" Tag="bilinear" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="OnnxProviderComboBox" Grid.Column="0" HorizontalAlignment="Stretch" Header="ArtCNN R16F96 / R8F64 ONNX Execution" SelectionChanged="SettingControl_Changed">
                                <ComboBoxItem Content="DirectML GPU Acceleration (Auto CPU Fallback)" Tag="DirectML" />
                                <ComboBoxItem Content="CPU Inference Only" Tag="CPU" />
                            </ComboBox>
                            <NumberBox
                                x:Name="OnnxTileSizeBox"
                                Grid.Column="1"
                                Header="ONNX Tile Size (px)"
                                Minimum="128"
                                Maximum="1024"
                                SmallChange="64"
                                LargeChange="128"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="SettingNumber_Changed" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Encoding & Output -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="18" />
                            <StackPanel>
                                <TextBlock Text="Encoding &amp; Output" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="FFmpeg video codec, hardware acceleration, CRF quality, audio handling, and default output folder" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VideoCodecComboBox" Grid.Column="0" HorizontalAlignment="Stretch" Header="Video Codec" SelectionChanged="SettingControl_Changed">
                                <ComboBoxItem Content="H.264 / AVC (Maximum Compatibility)" Tag="h264" />
                                <ComboBoxItem Content="H.265 / HEVC (Smaller Files)" Tag="hevc" />
                            </ComboBox>
                            <ComboBox x:Name="EncoderPreferenceComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Header="Encoder Hardware Preference" SelectionChanged="SettingControl_Changed">
                                <ComboBoxItem Content="Auto GPU (NVENC / QSV / AMF / MF) or CPU" Tag="Auto" />
                                <ComboBoxItem Content="Software CPU Only (libx264 / libx265)" Tag="Software" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="EncoderPresetComboBox" Grid.Column="0" HorizontalAlignment="Stretch" Header="Speed / Efficiency Preset" SelectionChanged="SettingControl_Changed">
                                <ComboBoxItem Content="ultrafast" Tag="ultrafast" />
                                <ComboBoxItem Content="veryfast" Tag="veryfast" />
                                <ComboBoxItem Content="fast" Tag="fast" />
                                <ComboBoxItem Content="medium" Tag="medium" />
                                <ComboBoxItem Content="slow (Balanced Quality)" Tag="slow" />
                                <ComboBoxItem Content="veryslow" Tag="veryslow" />
                            </ComboBox>
                            <NumberBox
                                x:Name="CrfBox"
                                Grid.Column="1"
                                Header="Quality (CRF / QP)"
                                Minimum="10"
                                Maximum="32"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="SettingNumber_Changed" />
                            <ComboBox x:Name="AudioModeComboBox" Grid.Column="2" HorizontalAlignment="Stretch" Header="Audio Stream Handling" SelectionChanged="SettingControl_Changed">
                                <ComboBoxItem Content="Auto (Stream Copy or AAC 192k)" Tag="Auto" />
                                <ComboBoxItem Content="Always Re-encode AAC 192k" Tag="Aac" />
                            </ComboBox>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Default Output Folder (Optional)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="DefaultOutputFolderBox"
                                    Grid.Column="0"
                                    PlaceholderText="Leave empty to default to each source video's folder..."
                                    TextChanged="SettingText_Changed" />
                                <Button Grid.Column="1" Content="Browse..." Click="BrowseDefaultOutputFolderButton_Click" />
                                <Button Grid.Column="2" Content="Clear" Click="ClearDefaultOutputFolderButton_Click" />
                            </Grid>
                        </StackPanel>

                        <ToggleSwitch x:Name="OverwriteExistingToggle" Header="Overwrite existing upscaled files without suffixing" Toggled="SettingControl_Changed" />
                    </StackPanel>
                </Expander>

                <!-- General & Logging -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                            <FontIcon Glyph="&#xE713;" FontSize="18" />
                            <StackPanel>
                                <TextBlock Text="Diagnostics &amp; Reset" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Diagnostic log file verbosity and factory default restore" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch x:Name="LoggingEnabledToggle" Grid.Column="0" Header="Enable diagnostic logging" Toggled="SettingControl_Changed" />
                            <ComboBox x:Name="LoggingLevelComboBox" Grid.Column="1" Header="Log Level" HorizontalAlignment="Stretch" SelectionChanged="SettingControl_Changed">
                                <ComboBoxItem Content="Low (0)" Tag="0" />
                                <ComboBoxItem Content="Medium (Default)" Tag="-1" />
                                <ComboBoxItem Content="High (2)" Tag="2" />
                            </ComboBox>
                            <Button
                                x:Name="OpenLogsFolderButton"
                                Grid.Column="2"
                                Content="Open Logs Folder"
                                VerticalAlignment="Bottom"
                                Click="OpenLogsFolderButton_Click" />
                        </Grid>

                        <Button Content="Reset All Settings to Defaults" Click="ResetDefaultsButton_Click" />
                    </StackPanel>
                </Expander>

                <!-- About Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="About CDBurner10 Upscaler" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="CDBurner10 Upscaler v10.5.9 (64-bit, GPLv3) • Built with .NET 10 + WinUI 3 • Powered by libmpv GLSL (Anime4K v4 &amp; ArtCNN), ONNX Runtime DirectML, and FFmpeg."
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                ToolTipService.ToolTip="Open CDBurner10 on GitHub"
                                Click="GitHubButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Width="16" Height="16" Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                                    <TextBlock Text="GitHub" />
                                </StackPanel>
                            </Button>
                            <Button
                                Content="About Upscaler..."
                                Click="AboutButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
